# Template for local-dev .env. Copy to .env and fill in.
#
# Loaded by:
#   scripts/local_seed.py      (tiny built-in parser)
#   uvicorn --env-file .env    (uvicorn's native flag)
#
# .env is gitignored; .env.example is checked in for newcomers.

# ---------------------------------------------------------------------------
# Project + Mongo
# ---------------------------------------------------------------------------

# String used as the GCP project id when modules need one at import time.
# Any value works locally as long as MONGO_URI_DIRECT is set and LOCAL_DEV=1.
PROJECT_ID=your-gcp-project-id

# Bypass Secret Manager — point straight at local Docker Mongo. Every secret
# (readonly + writer) resolves to this URI in local mode.
MONGO_URI_DIRECT=mongodb://localhost:27017

# Database name. Matches scripts/local_seed.py.
MONGO_DB=hindsight_guild

# ---------------------------------------------------------------------------
# Web API
# ---------------------------------------------------------------------------

# Tells services/web_api/main.py to skip BigQuery + Secret Manager init.
# BQ-dependent endpoints return empty defaults; Mongo-backed endpoints work.
LOCAL_DEV=1

# When the UI hits /api/draft, web_api enqueues a job that calls the
# pipeline A2A service at this URL. Start it locally with:
#   uvicorn agents.a2a_server:pipeline_a2a --env-file .env --port 8005
A2A_URL_PIPELINE=http://localhost:8005

# Lets web_api auto-derive http://localhost:<port> for every agent on
# single-agent handoffs. Ports come from agents/a2a_server.py.
A2A_URL_BASE=http://localhost

# Mongo-only fast mock when the A2A pipeline isn't running. Set to
# `synthetic` to enable, blank to require the real pipeline.
DRAFTING_FALLBACK=synthetic

# ---------------------------------------------------------------------------
# Gemini / ADK
# ---------------------------------------------------------------------------

# Route ADK through Google AI Studio (free tier) instead of Vertex AI when
# running locally. Set to 1 in production where Vertex is available.
GOOGLE_GENAI_USE_VERTEXAI=0

# Get a key at https://aistudio.google.com/app/apikey (free tier, ~60 RPM).
# REQUIRED for any local pipeline run; NEVER commit a real key.
GOOGLE_API_KEY=

# Override every agent to a single model (e.g. gemini-3.1-flash-lite) so the
# free tier can keep up. Leave blank on paid tier so Content / CMO get the
# frontier-grade gemini-3.5-flash.
LOCAL_OVERRIDE_MODEL=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------

# Hard kill switch — 1 to disable telemetry emit entirely. Normally leave
# blank: emit_action writes to Mongo first (always) and only tries BQ when
# a client can be built, so LOCAL_DEV runs land in Mongo's `actions`
# collection and the UI Queue picks them up.
TELEMETRY_DISABLED=
